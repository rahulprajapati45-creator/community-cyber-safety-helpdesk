# Rename this file to ".env" and update the values as needed.

# MongoDB connection string.
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/cyber_safety_helpdesk

# MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cyber_safety_helpdesk

# Port the Express server will run on
PORT=5000
